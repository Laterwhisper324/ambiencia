# ==============================================================================
# AMBIÊNCIA - Variáveis de Ambiente (.env.example)
# ==============================================================================

# Porta do servidor HTTP + Socket.IO
PORT=3001

# Ambiente de execução (development | production)
NODE_ENV=development

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# Senha simples do anfitrião (usada para proteger ações administrativas e criação/controle de salas)
HOST_PASSWORD=mestre123

# Caminho do banco de dados SQLite
DATABASE_PATH=./data/ambiencia.sqlite

# Diretório local onde os arquivos MP3 serão salvos (monte o Volume Persistente aqui em produção)
UPLOAD_DIR=./uploads

# Limite máximo de upload por arquivo MP3 (em Megabytes)
MAX_UPLOAD_MB=50

# Provedor de armazenamento de áudio: "local" (padrão) ou "s3" (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=local

# Configuração opcional para S3 / Cloudflare R2 (usada apenas quando STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ambiencia-audio
S3_ACCESS_KEY_ID=sua_access_key
S3_SECRET_ACCESS_KEY=sua_secret_key
S3_PUBLIC_BASE_URL=
